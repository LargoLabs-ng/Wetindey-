# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.

# ── Required to boot ────────────────────────────────────────────────────
# Neon Postgres connection string.
DATABASE_URL=

# Any long random string. `openssl rand -base64 32`
AUTH_SECRET=

# http://localhost:3000 in dev; the real origin in production. Used to build
# every link that leaves the app — ticket emails, payment callbacks, promoter
# share links — so a wrong value here sends people to the wrong place.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payments ────────────────────────────────────────────────────────────
# Use a TEST key in development. The webhook verifies its signature against
# this same secret, so the key and the webhook have to belong to one account.
PAYSTACK_SECRET_KEY=

# ── Email ───────────────────────────────────────────────────────────────
# Without these, tickets and QR codes never reach anyone.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: 'resend' (default), 'smtp' or 'sendgrid'.
# EMAIL_PROVIDER=resend
# SMTP_SERVICE=
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=

# ── File storage ────────────────────────────────────────────────────────
# Vercel Blob. Cover art, organiser logos and sponsor logos need it.
BLOB_READ_WRITE_TOKEN=

# ── Admin ───────────────────────────────────────────────────────────────
# Comma-separated. Who can reach /admin.
ADMIN_EMAILS=

# ── Optional ────────────────────────────────────────────────────────────
# Google sign-in. Omit both and only email/password sign-in is offered.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Shown to buyers as the contact address on tickets and emails.
# NEXT_PUBLIC_SUPPORT_EMAIL=
